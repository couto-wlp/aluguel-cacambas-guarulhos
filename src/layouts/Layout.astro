---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean;
}

const { title, description, transparentHeader = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-gray-50 text-gray-900 antialiased selection:bg-primary selection:text-accent">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="LYvCWB3GGB-UakxdE4JZXGCdl9j1G7W7POxc-qFu4fc" />
    
    <!-- Centralized SEO Component -->
    <SEO title={title} description={description} />
    <SchemaLocalBusiness />

    <!-- Resource Hints & Mobile LCP Preload -->
    <link rel="preload" href="/hero-bg-mobile.webp" as="image" type="image/webp" media="(max-width: 640px)">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all';this.onload=null;">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap">
    </noscript>
  </head>
  <body class="min-h-full flex flex-col font-sans bg-gray-50 text-gray-900 text-lg">
    <!-- Header Navigation Bar -->
    <header id="main-header" class={`fixed top-0 w-full z-50 transition-all duration-300 ${transparentHeader ? 'header-transparent bg-transparent border-transparent' : 'bg-white/95 backdrop-blur-md shadow-sm'}`}>
      <div class="container mx-auto px-6 md:px-12 h-[95px] flex items-center justify-between">
        
        <!-- Bloco 1: Logo (Esquerda) -->
        <div class="flex-1 flex justify-start">
          <a href="/" class="flex items-center gap-3 group hover:scale-105 active:scale-95 transition-all">
            <img src="/favicon.svg" alt="Logo Caçambas Guarulhos" width="44" height="44" decoding="async" class="w-11 h-11 object-contain drop-shadow-md transition-transform" />
            <span class={`logo-text font-black text-2xl tracking-tight transition-colors ${transparentHeader ? 'text-white' : 'text-gray-900'}`}>
              Caçambas Guarulhos
            </span>
          </a>
        </div>

        <!-- Bloco 2: Menu Desktop (Centro) -->
        <div class="hidden md:flex items-center gap-5">
          <a href="/" class={`nav-link text-base font-bold hover:text-primary transition-colors ${transparentHeader ? 'text-white' : 'text-gray-600'}`}>Home</a>
          <a href="/servicos" class={`nav-link text-base font-bold hover:text-primary transition-colors ${transparentHeader ? 'text-white' : 'text-gray-600'}`}>Serviços</a>
          <a href="/bairros" class={`nav-link text-base font-bold hover:text-primary transition-colors ${transparentHeader ? 'text-white' : 'text-gray-600'}`}>Bairros de Atuação</a>
          <a href="/sobre" class={`nav-link text-base font-bold hover:text-primary transition-colors ${transparentHeader ? 'text-white' : 'text-gray-600'}`}>Sobre Nós</a>
          <a href="/contato" class={`nav-link text-base font-bold hover:text-primary transition-colors ${transparentHeader ? 'text-white' : 'text-gray-600'}`}>Contato</a>
        </div>

        <!-- Bloco 3: CTA & Mobile Toggle (Direita) -->
        <div class="flex-1 flex justify-end items-center gap-4">
          <a href="https://wa.me/5511943758880" target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-primary text-accent font-bold hover:bg-yellow-400 hover:scale-105 active:scale-95 transition-all shadow-md shadow-primary/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg> WhatsApp
          </a>

          <!-- Mobile Menu Toggle Button -->
          <button id="menu-toggle" class="md:hidden flex flex-col justify-center gap-1.5 p-2 focus:outline-none hover:scale-105 active:scale-95 transition-all" aria-label="Abrir Menu">
            <span class={`mobile-bar block w-6 h-1 rounded-full ${transparentHeader ? 'bg-white' : 'bg-secondary'}`}></span>
            <span class={`mobile-bar block w-6 h-1 rounded-full ${transparentHeader ? 'bg-white' : 'bg-secondary'}`}></span>
            <span class={`mobile-bar block w-6 h-1 rounded-full ${transparentHeader ? 'bg-white' : 'bg-secondary'}`}></span>
          </button>
        </div>
        
      </div>
    </header>

    <!-- Mobile Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 absolute w-full left-0 top-[72px] shadow-2xl z-[999]">
      <div class="flex flex-col px-6 py-4">
        <a href="/" class="py-3 text-gray-900 font-bold border-b border-gray-100">Home</a>
        <a href="/servicos" class="py-3 text-gray-900 font-bold border-b border-gray-100">Serviços</a>
        <a href="/bairros" class="py-3 text-gray-900 font-bold border-b border-gray-100">Bairros de Atuação</a>
        <a href="/sobre" class="py-3 text-gray-900 font-bold border-b border-gray-100">Sobre Nós</a>
        <a href="/contato" class="py-3 text-gray-900 font-bold">Contato</a>
      </div>
    </div>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white pt-16 pb-8 mt-auto">
      <div class="container mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          
          <!-- Coluna 1: Logo e Sobre -->
          <div class="flex flex-col gap-6">
            <a href="/" class="flex items-center gap-3 group hover:scale-105 transition-transform w-fit">
              <img src="/favicon.svg" alt="Logo Caçambas Guarulhos" class="w-9 h-9 object-contain drop-shadow-sm" />
              <span class="font-black text-lg tracking-tight text-gray-900">
                Caçambas Guarulhos
              </span>
            </a>
            <p class="text-gray-600 leading-relaxed text-sm pr-4">
              Locação de caçambas estacionárias licenciadas para coleta e destinação ecologicamente correta de resíduos da construção civil em Guarulhos e região.
            </p>
            <div class="flex gap-3">
              <a href="https://wa.me/5511943758880" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded border border-gray-200 flex items-center justify-center text-gray-400 hover:border-primary hover:text-primary transition-all">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://wa.me/5511943758880" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded border border-gray-200 flex items-center justify-center text-gray-400 hover:border-primary hover:text-primary transition-all">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            </div>
          </div>

          <!-- Coluna 2: Navegação Rápida -->
          <div>
            <h4 class="font-black text-primary mb-6 uppercase tracking-wider text-sm">Navegação Rápida</h4>
            <ul class="flex flex-col gap-4">
              <li><a href="/" class="text-gray-600 text-sm hover:text-primary transition-all flex items-center gap-3"><div class="w-1.5 h-1.5 bg-primary"></div> Início</a></li>
              <li><a href="/servicos" class="text-gray-600 text-sm hover:text-primary transition-all flex items-center gap-3"><div class="w-1.5 h-1.5 bg-primary"></div> Nossos Serviços</a></li>
              <li><a href="/sobre" class="text-gray-600 text-sm hover:text-primary transition-all flex items-center gap-3"><div class="w-1.5 h-1.5 bg-primary"></div> Sobre Nós</a></li>
              <li><a href="/bairros" class="text-gray-600 text-sm hover:text-primary transition-all flex items-center gap-3"><div class="w-1.5 h-1.5 bg-primary"></div> Bairros de Atuação</a></li>
              <li><a href="/blog" class="text-gray-600 text-sm hover:text-primary transition-all flex items-center gap-3"><div class="w-1.5 h-1.5 bg-primary"></div> Blog</a></li>
              <li><a href="/contato" class="text-gray-600 text-sm hover:text-primary transition-all flex items-center gap-3"><div class="w-1.5 h-1.5 bg-primary"></div> Contato</a></li>
            </ul>
          </div>

          <!-- Coluna 3: Suporte & Logística -->
          <div>
            <h4 class="font-black text-primary mb-6 uppercase tracking-wider text-sm">Suporte & Logística</h4>
            <ul class="flex flex-col gap-6">
              <li class="flex items-center gap-4">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <div>
                  <span class="block text-[13px] text-gray-500 mb-0.5">Ligação</span>
                  <a href="tel:+5511943758880" class="text-gray-600 text-sm hover:text-primary transition-colors">(11) 94375-8880</a>
                </div>
              </li>
              <li class="flex items-center gap-4">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                <div>
                  <span class="block text-[13px] text-gray-500 mb-0.5">WhatsApp 24h</span>
                  <a href="https://wa.me/5511943758880" class="text-gray-600 text-sm hover:text-primary transition-colors">(11) 94375-8880</a>
                </div>
              </li>
              <li class="flex items-center gap-4">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                <div>
                  <span class="block text-[13px] text-gray-500 mb-0.5">E-mail Comercial</span>
                  <a href="mailto:contato@cacambasguarulhos.com.br" class="text-gray-600 text-sm hover:text-primary transition-colors">contato@cacambasguarulhos.com.br</a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Coluna 4: Operação & Meio Ambiente -->
          <div>
            <h4 class="font-black text-primary mb-6 uppercase tracking-wider text-sm">Operação & Meio Ambiente</h4>
            <div class="flex items-start gap-4 mb-8">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <p class="text-sm text-gray-600 leading-relaxed">
                {SITE_CONFIG.address.streetAddress}<br/>
                {SITE_CONFIG.address.addressLocality} - {SITE_CONFIG.address.addressRegion}, {SITE_CONFIG.address.postalCode}
              </p>
            </div>
            
            <div class="flex flex-col gap-4 text-sm ml-9">
              <div>
                <span class="text-gray-500 block mb-0.5">Licença SMMA:</span>
                <span class="font-bold text-gray-900">L.O. nº 0387/24</span>
              </div>
              <div class="border-t border-gray-100 pt-3">
                <span class="text-gray-500 block mb-0.5">Registro ATT:</span>
                <span class="font-bold text-gray-900">ATT-GR nº 092/24</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Linha Inferior (Bottom Bar) -->
        <div class="pt-8 border-t border-gray-200 flex flex-col md:flex-row items-center justify-between gap-4 text-[13px] text-gray-500">
          <p>&copy; {new Date().getFullYear()} {SITE_CONFIG.siteName}. Todos os direitos reservados.</p>
          <div class="flex items-center gap-6">
            <a href="/privacidade" class="hover:text-primary transition-colors">Política de Privacidade</a>
            <a href="/termos" class="hover:text-primary transition-colors">Termos de Uso</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Components -->
    <WhatsAppBtn />

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const menuClose = document.getElementById('menu-close');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuLinks = document.querySelectorAll('.menu-link');

      function openMenu() {
        if (!mobileMenu) return;
        mobileMenu.classList.remove('hidden');
        // Pequeno delay para a transição de opacidade funcionar
        setTimeout(() => {
          mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
          mobileMenu.classList.add('opacity-100', 'flex');
        }, 10);
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        if (!mobileMenu) return;
        mobileMenu.classList.remove('opacity-100');
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
          mobileMenu.classList.remove('flex');
          mobileMenu.classList.add('hidden');
        }, 300); // Aguarda o fim da transição
        document.body.style.overflow = '';
      }

      menuToggle?.addEventListener('click', openMenu);
      menuClose?.addEventListener('click', closeMenu);

      menuLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      // Header Scroll Effect (Transforma o menu transparente em branco ao rolar)
      const mainHeader = document.getElementById('main-header');
      if (mainHeader && mainHeader.classList.contains('header-transparent')) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 50) {
            mainHeader.classList.add('scrolled');
          } else {
            mainHeader.classList.remove('scrolled');
          }
        });
      }
    </script>
  </body>
</html>
