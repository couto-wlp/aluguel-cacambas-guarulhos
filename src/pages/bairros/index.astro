---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const bairrosContent = await getCollection('bairros');

const title = "Bairros de Atuação | Aluguel de Caçambas em Guarulhos";
const description = "Entregamos sua caçamba rapidamente em todos os bairros de Guarulhos. Garantimos total pontualidade, segurança e eficiência no seu serviço.";
---

<Layout title={title} description={description}>
  <section class="pt-[120px] pb-24 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-6 md:px-12">
      <!-- Cabeçalho -->
      <div class="text-center max-w-3xl mx-auto mb-6">
        <h1 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-6">
          Bairros de <span class="text-primary">Atuação</span>
        </h1>
        <p class="text-base text-gray-600 leading-relaxed">
          Entregamos sua caçamba rapidamente em todos os bairros de Guarulhos. Garantimos total pontualidade, segurança e eficiência no seu serviço.
        </p>
      </div>

      <!-- Layout de Grid (Menu Lateral + Cards) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-7xl mx-auto">
        
        <!-- Menu Lateral (Sticky) -->
        <aside class="lg:col-span-3">
          <div class="sticky top-24 bg-white rounded-2xl shadow-xl shadow-gray-200/50 border border-gray-100 overflow-hidden">
            <div class="p-5 border-b border-gray-100 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              <h2 class="text-lg font-black text-gray-900">Bairros Atendidos</h2>
            </div>
            <div class="max-h-[70vh] overflow-y-auto custom-scrollbar">
              <ul class="flex flex-col">
                {bairrosContent.map((bairro) => (
                  <li>
                    <a href={`/bairros/${bairro.slug}`} 
                      class="flex items-center justify-between py-1 px-4 hover:bg-gray-50 border-b border-gray-50 text-[16px] text-gray-700 hover:text-yellow-500 font-bold transition-colors group"
                    >
                      {bairro.data.name}
                      <span class="text-gray-300 group-hover:text-yellow-500 transition-colors">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>

        <!-- Cards de Bairros -->
        <main class="lg:col-span-9">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {bairrosContent.map((bairro) => (
              <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/40 border border-gray-100 p-8 flex flex-col h-full hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Atendimento em Guarulhos</span>
                
                <h3 class="text-[18px] md:text-[22px] font-bold text-gray-900 leading-tight mb-4">
                  Aluguel de Caçamba no {bairro.data.name} | Guarulhos - SP
                </h3>

                {bairro.data.description && (
                  <p class="text-[16px] text-gray-600 mb-8 flex-grow">
                    {bairro.data.description}
                  </p>
                )}
                
                <a href={`/bairros/${bairro.slug}`} 
                  class="inline-flex items-center gap-2 text-primary hover:text-yellow-500 font-bold group mt-auto"
                >
                  Ver Detalhes do Bairro
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            ))}
          </div>
        </main>

      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-24 md:pb-32 bg-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.05)_0,transparent_100%)] pointer-events-none"></div>
    <div class="container mx-auto px-6 md:px-12 relative z-10 text-center">
      <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-8 tracking-tighter leading-tight">Estamos no <span class="text-primary">seu bairro!</span></h2>
      <p class="text-base text-gray-700 mb-12 max-w-2xl mx-auto">
        Nossos especialistas estão prontos para entregar a caçamba ideal no seu endereço. Fale com a gente agora!
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a href="https://wa.me/5511943758880" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-10 py-5 rounded-xl bg-primary hover:bg-yellow-400 text-gray-900 font-black text-base transition-all shadow-lg text-center hover:scale-105 active:scale-95">
          Conversar no WhatsApp
        </a>
        <a href="tel:+5511943758880" class="w-full sm:w-auto px-10 py-5 rounded-xl bg-black hover:bg-gray-800 text-white font-black text-base transition-all shadow-lg text-center hover:scale-105 active:scale-95">
          Ligar Agora
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Custom Scrollbar for the sidebar */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f1f1; 
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #eab308; /* Tailwind yellow-500 */
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #ca8a04; /* Tailwind yellow-600 */
    }
  </style>
</Layout>
