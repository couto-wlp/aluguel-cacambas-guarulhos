---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const bairrosContent = await getCollection('bairros');
  return bairrosContent.map((entry) => ({
    params: { bairro: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const title = entry.data.title || `Aluguel de Caçamba no ${entry.data.name} - Guarulhos - SP`;
const description = entry.data.description || `Precisando de caçamba de entulho no bairro ${entry.data.name} em Guarulhos? Alugue agora com entrega rápida, segurança e o melhor preço.`;
---

<Layout title={title} description={description}>
  <!-- 1. Hero Section (Fundo Claro Branco/Cinza) -->
  <section class="pt-36 pb-20 bg-white border-b border-gray-100 text-gray-900 relative overflow-hidden">
    <div class="container mx-auto px-6 md:px-12 relative z-10 max-w-4xl text-center flex flex-col items-center">
      <!-- Tag Local -->
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">
        Atendimento Local em Guarulhos
      </p>

      <!-- Título Principal -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-900 tracking-tight leading-tight mb-6 max-w-3xl mx-auto">
        Aluguel de Caçamba no <span class="text-primary">{entry.data.name}</span>
      </h1>

      <!-- Subtítulo -->
      <p class="text-base md:text-lg text-gray-600 leading-relaxed mb-8 max-w-3xl mx-auto">
        {description}
      </p>

      <!-- Botões de Ação -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <a 
          href={`https://wa.me/5511943758880?text=Olá! Gostaria de um orçamento para o bairro ${entry.data.name}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-primary hover:bg-yellow-400 text-gray-900 font-black text-base transition-all shadow-lg text-center hover:scale-105 active:scale-95"
        >
          Orçamento via WhatsApp
        </a>
        <a 
          href="/servicos"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-black hover:bg-gray-800 text-white font-bold text-base transition-all text-center hover:scale-105 active:scale-95"
        >
          Ver Caçambas
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Destaques (3 Cards Brancos em Linha) -->
  <section class="bg-gray-50 pt-10 pb-12">
    <div class="container mx-auto px-6 md:px-12 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="bg-white p-8 rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 flex flex-col items-start">
          <div class="w-12 h-12 rounded-xl bg-primary text-gray-900 shadow-md shadow-primary/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-xl font-black text-gray-900 mb-2">Logística Expressa</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Entrega e remoção rápidas e pontuais no bairro {entry.data.name}, respeitando o cronograma de sua construção ou reforma.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-white p-8 rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 flex flex-col items-start">
          <div class="w-12 h-12 rounded-xl bg-primary text-gray-900 shadow-md shadow-primary/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-black text-gray-900 mb-2">Descarte 100% Legal</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Emissão completa de MTR e conformidade total com as normas da Secretaria Municipal de Meio Ambiente (SMMA) de Guarulhos.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-white p-8 rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 flex flex-col items-start">
          <div class="w-12 h-12 rounded-xl bg-primary text-gray-900 shadow-md shadow-primary/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="text-xl font-black text-gray-900 mb-2">Posicionamento Seguro</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Motoristas experientes que posicionam a caçamba de forma regularizada na rua ou calçada de sua obra no {entry.data.name}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Área Principal: Conteúdo do Artigo (Esquerda) + Card Orçamento Sticky (Direita) -->
  <section class="pb-24 bg-gray-50">
    <div class="container mx-auto px-6 md:px-12 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Coluna Esquerda: Texto Markdown do Bairro -->
        <div class="lg:col-span-8 bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-gray-100">
          <article class="prose prose-lg max-w-none prose-headings:font-black prose-headings:text-gray-900 prose-h1:text-2xl prose-h1:md:text-4xl prose-h1:mb-6 prose-h2:text-xl prose-h2:md:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-p:text-gray-600 prose-p:leading-relaxed prose-strong:text-gray-900 prose-li:text-gray-600">
            <Content />
          </article>
        </div>

        <!-- Coluna Direita: Sticky Card Orçamento Amarelo -->
        <div class="lg:col-span-4 sticky top-28">
          <div class="bg-primary rounded-3xl p-8 text-gray-900 shadow-2xl border border-yellow-300 text-center">
            <span class="text-[11px] font-black uppercase tracking-widest text-gray-900/80 mb-3 block">
              Orçamento Gratuito
            </span>
            <h3 class="text-xl md:text-2xl font-black leading-tight mb-6 text-gray-900">
              Interessado em alugar uma caçamba no {entry.data.name}?
            </h3>

            <div class="space-y-4 mb-8">
              <a 
                href={`https://wa.me/5511943758880?text=Olá! Gostaria de um orçamento para caçamba no bairro ${entry.data.name}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full py-4 px-6 rounded-xl bg-black hover:bg-gray-900 text-white font-black text-base transition-all shadow-lg hover:scale-105 active:scale-95"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                Pedir no WhatsApp
              </a>

              <a 
                href="tel:+5511943758880"
                class="flex items-center justify-center gap-2 w-full py-4 px-6 rounded-xl bg-white hover:bg-gray-100 text-gray-900 font-bold text-base transition-all hover:scale-105 active:scale-95 shadow-sm"
              >
                📞 Ligar Agora
              </a>
            </div>

            <p class="text-xs text-gray-800 font-medium mb-1">Dúvidas? Fale com um especialista.</p>
            <a href="tel:+5511943758880" class="text-lg font-black text-gray-900 hover:underline block">
              (11) 94375-8880
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
