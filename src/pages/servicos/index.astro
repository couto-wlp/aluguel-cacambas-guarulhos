---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getServicePath } from '../../data/serviceUrls';

const servicos = await getCollection('servicos');

const serviceCardDescriptions: Record<string, string> = {
  'cacamba-4m': 'Perfeita para restos de alvenaria, pisos quebrados e pequenas demolições residenciais. Ocupa pouco espaço e recebe materiais densos dentro do limite de carga. Gesso e outros recicláveis devem ser informados previamente para triagem e destinação adequadas.',
  'cacamba-5m': 'A medida certa para telhas, solo de pequenas escavações e resíduos de ampliações ou limpezas de obra. Oferece excelente equilíbrio entre volume e capacidade de carga. Madeira deve ser separada dos resíduos minerais e informada na contratação.',
  'cacamba-6m': 'Solução ideal para resíduos volumosos de reformas comerciais, ajudando a manter o canteiro organizado. Drywall, gesso e resíduos de poda exigem avaliação prévia e separação conforme a destinação adequada de cada material.',
  'cacamba-7m': 'Voltada ao fluxo intenso de descarte em condomínios, construtoras e grandes obras. Atende volumes elevados, desde que concreto, metais, plásticos e outros materiais sejam separados conforme sua classe e respeitem o limite de carga.',
  'cacamba-8m': 'Opção de alta capacidade volumétrica para obras de grande porte. Pode receber solo, blocos e resíduos de demolição dentro do limite de peso definido para o equipamento, com dimensionamento conforme a densidade do material.',
  'cacamba-roll-on': 'Sistema de grande volume para indústrias, galpões, shoppings e polos logísticos. Indicado para resíduos não perigosos e devidamente classificados, exige área ampla para a manobra segura do caminhão e operação contínua.'
};
---

<Layout title="Aluguel de Caçambas em Guarulhos - SP | Nossos Serviços">
  <section class="pt-[120px] pb-24 bg-gray-50 min-h-[80vh]">
    <div class="container mx-auto px-6 md:px-12 max-w-6xl">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">
          Nossos <span class="text-primary">Serviços</span>
        </h1>
        <p class="text-base text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Oferecemos soluções completas em locação de caçambas para obras de todos os portes. Escolha o equipamento ideal para garantir o descarte rápido, seguro e ecologicamente correto do seu entulho.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
        {servicos.map(servico => (
          <a href={getServicePath(servico.slug)} class="block group">
            <div class="h-full bg-white p-10 rounded-2xl shadow-lg shadow-gray-200/40 border border-gray-100 group-hover:border-primary/50 group-hover:-translate-y-2 transition-all">
              {servico.data.image && (
                <div class="mb-6 h-[201px] flex items-center justify-center">
                  <img src={servico.data.image} alt={servico.data.title} class="w-full h-full object-contain hover:scale-105 transition-transform duration-300" />
                </div>
              )}
              <h2 class="text-2xl font-black text-gray-900 mb-4 group-hover:text-secondary transition-colors">
                {servico.data.title}
              </h2>
              <p class="text-gray-600 text-base">
                {serviceCardDescriptions[servico.slug] ?? servico.data.description}
              </p>
              <div class="mt-8 font-bold text-primary flex items-center gap-2 group-hover:text-yellow-500 transition-colors">
                Saiba Mais <span>&rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 md:pb-32 bg-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.05)_0,transparent_100%)] pointer-events-none"></div>
    <div class="container mx-auto px-6 md:px-12 relative z-10 text-center">
      <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-8 tracking-tighter leading-tight">Precisa de uma <span class="text-primary">caçamba?</span></h2>
      <p class="text-base text-gray-700 mb-12 max-w-2xl mx-auto">
        Nossos especialistas estão prontos para indicar a caçamba ideal e fechar o melhor orçamento para você.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a href="https://wa.me/5511943758880" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-10 py-5 rounded-xl bg-primary hover:bg-yellow-400 text-gray-900 font-black text-base transition-all shadow-lg text-center hover:scale-105 active:scale-95">
          Conversar no WhatsApp
        </a>
        <a href="tel:+5511943758880" class="w-full sm:w-auto px-10 py-5 rounded-xl bg-black hover:bg-gray-800 text-white font-black text-base transition-all shadow-lg text-center hover:scale-105 active:scale-95">
          Ligar Agora
        </a>
      </div>
    </div>
  </section>
</Layout>
