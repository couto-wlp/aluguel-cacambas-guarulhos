---
import { SITE_CONFIG } from '../data/config';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  publishDate: Date;
  updatedDate?: Date;
}

const { title, description, path, image, publishDate, updatedDate } = Astro.props;
const pageUrl = new URL(path, SITE_CONFIG.siteUrl).href;
const imageUrl = new URL(image || '/og-image-central-v2.jpg', SITE_CONFIG.siteUrl).href;
const modified = updatedDate || publishDate;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: imageUrl,
  datePublished: publishDate.toISOString(),
  dateModified: modified.toISOString(),
  author: {
    '@type': 'Organization',
    name: SITE_CONFIG.authorName,
    url: SITE_CONFIG.siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.siteName,
    url: SITE_CONFIG.siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_CONFIG.siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  inLanguage: 'pt-BR',
  about: ['Aluguel de caçamba', 'Gestão de resíduos', 'Guarulhos'],
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: SITE_CONFIG.siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${SITE_CONFIG.siteUrl}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: pageUrl,
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
