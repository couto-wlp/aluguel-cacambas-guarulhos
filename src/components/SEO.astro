---
import { SITE_CONFIG } from '../data/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = SITE_CONFIG.siteTitle,
  description = SITE_CONFIG.siteDescription,
  image = `${SITE_CONFIG.siteUrl}/og-image.jpg`,
  canonicalUrl: canonicalUrlProp,
} = Astro.props;

const canonical = new URL(
  canonicalUrlProp || Astro.url.pathname,
  Astro.site || SITE_CONFIG.siteUrl,
);

if (canonical.pathname !== '/') {
  canonical.pathname = canonical.pathname.replace(/\/+$/, '');
}

const canonicalUrl = canonical.href;
---

<!-- SEO Principal -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content="Caçamba para obras e reformas em Guarulhos" />
<meta property="og:site_name" content={SITE_CONFIG.siteName} />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta property="twitter:image:alt" content="Caçamba para obras e reformas em Guarulhos" />
